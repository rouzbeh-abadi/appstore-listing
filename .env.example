# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored. Never commit it.
#
# All four come from App Store Connect, under Users and Access,
# Integrations, Keys.

# The 10-character code shown beside the key (also in the AuthKey_<KeyID>.p8 filename).
ASC_KEY_ID=

# The UUID above the key table, the same for every key in your team.
ASC_ISSUER_ID=

# Path to the .p8 itself. Set it and the UI just uses it; leave it empty and the
# UI asks you to upload the file instead.
#
# A relative path is resolved next to this .env, so keeping the key beside it
# survives the folder being renamed or moved to another machine. An absolute
# path is used exactly as written.
ASC_KEY_PATH=AuthKey_XXXXXXXXXX.p8

# Optional: pre-fills the bundle ID field.
ASC_BUNDLE_ID=com.example.myapp
